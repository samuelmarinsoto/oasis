From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: oasis <oasis@localhost>
Date: Sat, 26 Sep 2026 18:57:53 -0600
Subject: [PATCH] speex_resampler.h: force OUTSIDE_SPEEX, prefix symbols

From UXP media/libspeex_resampler/outside-speex.patch: always take the
OUTSIDE_SPEEX branch of the public header so it typedefs its own
spx_* types and renames every entry point via
RANDOM_PREFIX=moz_speex, avoiding clashes with a real speex install.
---
diff --git a/include/speex/speex_resampler.h b/include/speex/speex_resampler.h
index 50d777f..1def7ff 100644
--- a/include/speex/speex_resampler.h
+++ b/include/speex/speex_resampler.h
@@ -39,7 +39,7 @@
 #ifndef SPEEX_RESAMPLER_H
 #define SPEEX_RESAMPLER_H
 
-#ifdef OUTSIDE_SPEEX
+#if 1 /* OUTSIDE_SPEEX */
 
 /********* WARNING: MENTAL SANITY ENDS HERE *************/
 
@@ -47,6 +47,7 @@
    there won't be any clash if linking with Speex later on. */
 
 /* #define RANDOM_PREFIX your software name here */
+#define RANDOM_PREFIX moz_speex
 #ifndef RANDOM_PREFIX
 #error "Please define RANDOM_PREFIX (above) to something specific to your project to prevent symbol name clashes"
 #endif
